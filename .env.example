# 环境变量示例 —— 复制为 .env 并填入真实值（.env 已在 .gitignore，绝不提交）

# ⚠️ 合规警告：必须使用小米「程序化 / 按量计费」API key
# 不可使用交互套餐 key（base URL 含 token-plan 的那个）！
# 交互套餐条款禁止「自动化脚本 / 后端调用」，违规可能导致封号。
MIMO_API_KEY=your_programmatic_api_key
MIMO_BASE_URL=https://your-programmatic-endpoint/v1
MIMO_MODEL=mimo-model-name

# 缓存根目录（下分 {源id}/ 子目录）
CACHE_DIR=./cache
